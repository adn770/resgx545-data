#!/bin/bash
# fake ssh for tests/run_mock.sh: "the laptop" is the directory $FAKE_HOME.  Options (-o X) are skipped, the host is ignored, the
# command runs in bash with HOME=$FAKE_HOME (the sudo shim and the fake tool find the rest in the environment).  The knob read of the
# driver (a `sudo -n sh -c "cat $d/alias_skip; cat $d/render_rgn_arrays; cat $d/render_pb_pages"`) answers from the fake debugfs.
while [ "${1:-}" = "-o" ]; do shift 2; done
shift
cmd=$1
case "$cmd" in
*render_rgn_arrays*) [ -n "${FAKE_KNOB_UNREADABLE:-}" ] && exit 1
	printf '0x%08x\n' $(( $(cat "${FAKE_DBGREAL:?}/alias_skip") ))
	if [ -n "${FAKE_KNOB_LEAK:-}" ]; then echo 0x00000004; else printf '0x%08x\n' $(( $(cat "${FAKE_DBGREAL:?}/render_rgn_arrays") )); fi
	if [ -n "${FAKE_PB_LEAK:-}" ]; then echo 0x00000083; else printf '0x%08x\n' $(( $(cat "${FAKE_DBGREAL:?}/render_pb_pages") )); fi
	exit 0 ;;
esac
cd "${FAKE_HOME:?}" && HOME=$FAKE_HOME exec bash -c "$cmd"
