# r3.env: the laptop binaries R3-pixel reuses from R1 (~/sgxfive-test-r1: userspace/libsgxfive/tools/sgxfive-test.c sha256
# 4250ca36..., TOOL.sha256 / TOOLSRC.sha256 of closing2/r1-pixgeo, copied here; ~/regtimeline is S1's, built from tools/sweep)
# and the R3-pixel timing.  Sourced by lib_r3.sh on the laptop.  The preflight refuses a tool or regtimeline with another
# sha256 and a kernel module that is not the expected build: STOP AND ASK (nothing is rebuilt).
TOOL_SHA=bf4f8be2d8a8fe50034559450928e05695dc96d396d4892f9b00ea6bc0d4f053
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
SRCV_EXPECT=B21FDA82BD5E5CB5A627E3B
# regtimeline: TOTAL (0 = until the command ends) and LEAD seconds before the tool starts
RT_LEAD=${RT_LEAD:-0.3}
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
