# SPDX-License-Identifier: MIT
# r7.env: the laptop binaries and modules R7-dpm uses, sourced by lib_r7.sh on the laptop and by stage_r7.sh on the Mac.
# ~/sgxfive-test-rgn4 (round 4's tool, built from resgx545 r3-rgn4 4623753, sgxfive-test.c sha256 703cbcea..., TOOLSRC.sha256: the
# pin of R4-pixel, R5-dpm, R6-dpm and R6-held) and ~/regtimeline (S1's, built from tools/sweep/regtimeline.c, read-only /dev/mem reads).
# The preflight refuses another tool, another regtimeline or a module that is not the stage's set's: STOP AND ASK, nothing is rebuilt.
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
# set A (s-a0, s-m, s-b, s-v): the test module of fork 3f0b3e74 (rgn4 + render_tail_room + peek + bif_flush; handover r6), loaded now
SRCV_A=41E2F5C756F96D20F7109A4
# set B (s-k): the module of fork 664fd0d0 (round 7's own-task register list: ldr of 0x0724 and 0x072c), delivered by
# closing7/kernel/deliver-r7.sh (gma500_gfx.ko sha256 cfae29f8...), installed and booted once by the lead before set B
SRCV_B=37EC97AB0CB37213C42FCCC
# the own task of set B (bins/oomring2.blob, gen/gen_oomring2.py) and its arm string (PDS #13 slots 0 to 3, entries 0..3)
OOMRING2_SHA=c855818ec4334a0826be4361f0c0c1ae6819fba681e7b9f3a4f9dab028399676
OOMRING_ARM="slots=0xf entry=0,1,2,3"
# regtimeline: TOTAL 0 (until the command ends) and LEAD seconds before the tool starts
RT_LEAD=${RT_LEAD:-0.3}
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
