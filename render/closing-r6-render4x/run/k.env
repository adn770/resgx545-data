# SPDX-License-Identifier: MIT
# k.env: the laptop binary r6-render4x stage A uses (unchanged since R4-G) and the module it expects.  Sourced by lib_k.sh on the laptop and by stage_k.sh.
# ~/sgxfive-test-rgn4: built from resgx545 r3-rgn4 4623753 (sgxfive-test.c sha256 703cbcea..., TOOLSRC.sha256); a tool with another
# sha256 or a module that is not the expected build: STOP AND ASK (nothing is rebuilt).
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
# the gma500 module of fork a2788bd8 (round 3 plus four region-header arrays for 4x contexts, the rgn4 boot): loaded = installed = this
SRCV_EXPECT=99CD90DA26E3AFF9C450517
# a job (the largest are a3 and a14, 1.3 and 1.6 Mpixel, checked pixel by pixel on the laptop's CPU)
JOB_TIMEOUT=${JOB_TIMEOUT:-300}
# the held jobs (h1, h2): the registers are read HOLD_READ s after the launch (E444, K2: 2.8 s), again HOLD_GAP s later, then the
# kernel's own debugfs reset with the hold still Y; the job is bounded by HELD_TIMEOUT
HOLD_READ=${HOLD_READ:-2.8}
HOLD_GAP=${HOLD_GAP:-1}
HELD_TIMEOUT=${HELD_TIMEOUT:-60}
# free space on ~ before each job (MiB; the plan's 300, above HACKING's 200): a job keeps at most a few MB of gzipped dumps
MIN_FREE_MB=${MIN_FREE_MB:-300}
