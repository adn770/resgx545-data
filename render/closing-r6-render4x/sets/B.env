# SPDX-License-Identifier: MIT
# sets/B.env: r6-render4x stage B (plan section 4) on the r6-kernel module (linux fork branch r6-kernel, tip 3f0b3e74: debugfs
# render_tail_room; srcversion 41E2F5C756F96D20F7109A4, run-b/k.env), the session's SECOND freeze set.  Sourced by run/k.sh,
# run/stage_k.sh, run/freeze_k.sh (`--set B` / `B`) and run-b/guard_b.sh.  Its files are its own (stages-B.txt, FROZEN-B.sha256,
# PREDICTIONS-B.sha256, tables/{s0b,b,k,r}.txt, predictions/{s0b,b,k,kh,r}.tsv, run-b/, score/score_b.py, gen/rgen_b.py,
# gen/layout_b.py); it pins, unchanged, the set A files it uses (the drivers run/k.sh, run/stage_k.sh, run/freeze_k.sh,
# run/lib_check.sh, the scorer and generator helpers it imports).  Set A's freeze (FROZEN.sha256) is never touched.
SET_NAME=B
SET_STAGES=stages-B.txt
SET_FREEZE=FROZEN-B.sha256
SET_PREDS=PREDICTIONS-B.sha256
SET_RUNDIR=run-b
SET_SCORER=score/score_b.py
SET_GUARD=run-b/guard_b.sh
SET_TABLES="tables/s0b.txt tables/b.txt tables/k.txt tables/r.txt"
SET_PREDFILES="predictions/s0b.tsv predictions/b.tsv predictions/k.tsv predictions/kh.tsv predictions/r.tsv"
SET_BINS=""
set_files() {
	echo gen/rgen_b.py gen/layout_b.py gen/rgen.py gen/frozen_commits.py gen/pbmodel.py gen/rlib.py gen/rules.py gen/twins.py
	echo gen/data/twins-B.tsv gen/data/sources-B.lst
	echo score/score_b.py score/score_r.py score/scorekit.py
	echo run/freeze_k.sh run/k.sh run/lib_check.sh run/stage_k.sh run-b/guard_b.sh run-b/lib_k.sh run-b/run_stage.sh run-b/k.env
	echo sets/B.env stages-B.txt TABLES-B.md TOOL.sha256 TOOLSRC.sha256
	echo $SET_TABLES $SET_PREDFILES
	cat gen/data/sources-B.lst
}
# the per-stage alarm of the driver (s): b nine jobs up to 3.1 Mpixel; k five with three faults and a held row; r three of 4 Mpixel
alarm_of() { case "$1" in s0b) echo 900 ;; b) echo 1800 ;; k) echo 1500 ;; r) echo 1500 ;; *) echo 900 ;; esac; }
