# SPDX-License-Identifier: MIT
# sets/A.env: r6-render4x stage A (the rgn4 boot as it stands, plan section 2 and Q293's four rows), one FREEZE SET of the session.
# Sourced by run/k.sh, run/stage_k.sh, run/freeze_k.sh and run/guard_k.sh (`--set A`, the default).  A later freeze (stage B, the new
# kernel) adds sets/B.env with its own freeze file, stages file, tables, predictions, scorer, runner directory and guard, and never
# touches a file listed here: stage A's FROZEN.sha256 then still verifies byte for byte (tests/run_mock.sh adds a fake set B to a copy
# of the tree and checks exactly that).
SET_NAME=A
SET_STAGES=stages.txt
SET_FREEZE=FROZEN.sha256
SET_PREDS=PREDICTIONS.sha256
SET_RUNDIR=run
SET_SCORER=score/score_r.py
SET_GUARD=run/guard_k.sh
SET_TABLES="tables/s0.txt tables/a.txt tables/t.txt"
SET_PREDFILES="predictions/s0.tsv predictions/a.tsv predictions/h.tsv predictions/t.tsv"
SET_BINS="bins/p1131-green__0.bin bins/p1131-psizes__1.bin"
# the knobs every stage of the set must leave at their defaults (read by k.sh after a stage): alias_skip 0, render_rgn_arrays 0,
# render_pb_pages 0x422 (fork a2788bd8's)
# every file of the freeze, by name (no glob: a later set's files never fall into stage A's list)
set_files() {
	echo gen/frozen_commits.py gen/pbmodel.py gen/rgen.py gen/rlib.py gen/rules.py gen/twins.py
	echo gen/data/twins.tsv gen/data/recorded_cells.tsv gen/data/sources.lst
	echo score/score_r.py score/scorekit.py
	echo run/freeze_k.sh run/guard_k.sh run/k.sh run/lib_check.sh run/lib_k.sh run/run_stage.sh run/stage_k.sh run/k.env
	echo sets/A.env stages.txt TABLES.md TOOL.sha256 TOOLSRC.sha256
	echo $SET_TABLES $SET_PREDFILES $SET_BINS
}
# the per-stage alarm of the driver (s): a carries 13 jobs, up to 1.6 Mpixel, 6 predicted faults with their strict health pairs
alarm_of() { case "$1" in s0) echo 900 ;; a) echo 2400 ;; t) echo 600 ;; *) echo 900 ;; esac; }
