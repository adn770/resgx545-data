# SPDX-License-Identifier: MIT
# run-b/k.env: set B (stage B on the r6-kernel module).  Sourced by run-b/lib_k.sh on the laptop and by run/stage_k.sh --set B.
# ~/sgxfive-test-rgn4 unchanged (no uAPI change in the series): built from resgx545 r3-rgn4 4623753; a tool with another sha256: STOP AND ASK.
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
# the gma500 module of linux fork branch r6-kernel at 3f0b3e74 (56f8b932 tail room, db7faabc peek, 3f0b3e74 bif_flush), built by the
# lead on cachix: vermagic 7.3.0-resgx545 SMP preempt mod_unload 686, module sha256 8a32dada935e8a293b7be03c5d1938cc31093fea4b356ed41f9cb476d421576a.
# Loaded = installed = this (the rgn4 module 99CD90DA... is refused).
SRCV_EXPECT=41E2F5C756F96D20F7109A4
# a job (the largest are r1, 4096 x 960, and r2, 2048 x 2032, about 4 Mpixel each, checked pixel by pixel on the laptop's CPU)
JOB_TIMEOUT=${JOB_TIMEOUT:-300}
# the held job (k3): registers HOLD_READ s after the launch, again HOLD_GAP s later, then the debugfs reset with the hold still Y
HOLD_READ=${HOLD_READ:-2.8}
HOLD_GAP=${HOLD_GAP:-1}
HELD_TIMEOUT=${HELD_TIMEOUT:-60}
# free space on ~ before each job (MiB)
MIN_FREE_MB=${MIN_FREE_MB:-300}
