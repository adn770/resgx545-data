# SPDX-License-Identifier: MIT
# g.env: the laptop binaries r7-geo uses and the module it expects.  Sourced by lib_g.sh on the laptop and by stage_g.sh / g.sh.
# t4 = ~/sgxfive-test-rgn4: built from resgx545 r3-rgn4 4623753 (sgxfive-test.c sha256 703cbcea..., TOOLSRC.sha256), unchanged
# since round 4.  t6 = ~/scratch/r7g/bin/sgxfive-test: round 6's t6 (resgx545 d9b2969, sha256 97df5c0e..., TOOL6.sha256, the binary
# the lead built on cachix for r6-misc, kept in bin/t6/ here and staged by stage_g.sh) for the two odd-height sizes only.  A tool
# with another sha256 or a module that is not the expected build: STOP AND ASK (nothing is rebuilt on the laptop).
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
TOOL6_SHA=97df5c0ebf5bff2786a59b302e9a8a722bad36f0ef2f5dba11b6f2957f4ad98c
# the gma500 module of fork r6-kernel 3f0b3e74 (rgn4 + render_tail_room + peek + bif_flush): loaded = installed = this
SRCV_EXPECT=41E2F5C756F96D20F7109A4
# the session's laptop prefix (round 7: ~/scratch/<prefix>/{run,stage,out,bin}; work dirs mktemp -d ~/scratch/tmp/r7g.XXXXXX)
PREFIX=r7g
# a job (the largest: zd's 4096 x 4096 depth jobs, a 64 MB buffer dumped)
JOB_TIMEOUT=${JOB_TIMEOUT:-300}
# free space on ~ before each job (KiB): 200 MB (round 6 rule), plus 8 KiB a depth page for a --depth-pages row (raw dump + gzip)
MIN_FREE_KB=${MIN_FREE_KB:-204800}
