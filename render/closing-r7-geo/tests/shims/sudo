#!/bin/bash
# fake sudo for tests/run_mock.sh (from round 5's r5-render4x shim, narrowed).  The mock debugfs directory $SGXFIVE_DEBUGFS is mode
# 000: only through this shim (as on the laptop, where debugfs is root only) does a path in it reach the real files in $FAKE_DBGREAL.
# regs and reset act on the fake GPU state in $FAKE_DIR/state ("idle" or "STAT WORD STATUS2 STATUS": a latched fault).  A leading
# `timeout [-k K] N` is stripped.  EVERY debugfs write is logged in $FAKE_DIR/writes ("NAME VALUE"); a write to anything but reset
# also goes to $FAKE_DIR/other-writes (r7-geo writes no knob).  The reset logs the kernel's two reset lines and disarms the kpokes.
# Knobs: FAKE_STUCK (a reset leaves the fault latched), FAKE_SNAP_FAIL (regs unreadable), FAKE_RESET_FAIL_FROM (the Nth reset and
# later fail).  The fake tool runs with the shim's environment (it is the tool, run as root on the laptop).
[ "$1" = "-n" ] && shift
DB=${SGXFIVE_DEBUGFS:?}; R=${FAKE_DBGREAL:?}; F=${FAKE_DIR:?}
if [ "$1" = timeout ]; then shift; [ "$1" = "-k" ] && shift 2; shift; fi
case "$1" in dmesg) cat "${KMSG:-/dev/null}"; exit 0 ;; journalctl) exit 1 ;; esac
regs() {
	read -r w a s2 s < "$F/state"
	if [ "$w" = idle ]; then w=0; a=0; s2=0x400; s=0x20000000; fi
	printf 'sgxfive regs 1\nreg 0x0000 0x0000a6aa\nreg 0x0114 skip\nreg 0x0118 0x%08x\nreg 0x012c 0x%08x\n' $((s2)) $((s))
	printf 'reg 0x0c00 0x00000000\nreg 0x0c04 0x%08x\nreg 0x0c08 0x%08x\n' $(( w | 0x80000 )) $((a))
}
if [ "$1" = cat ]; then
	case "$2" in
	"$DB/regs") [ -n "${FAKE_SNAP_FAIL:-}" ] && { echo "cat: regs: Input/output error" >&2; exit 1; }
		regs; exit 0 ;;
	"$DB/hold_recovery") cat "$R/hold_recovery"; exit 0 ;;
	"$DB/kpoke") cat "$R/kpoke"; exit 0 ;;
	"$DB/alias_skip"|"$DB/render_pb_pages"|"$DB/render_rgn_arrays"|"$DB/render_tail_room") printf '0x%08x\n' $(( $(cat "$R/${2##*/}") )); exit 0 ;;
	esac
fi
if [ "$1" = tee ]; then
	case "$2" in
	"$DB/reset")
		cat > /dev/null
		echo "reset 1" >> "$F/writes"
		echo "x" >> "$F/reset-tries"
		if [ -n "${FAKE_RESET_FAIL_FROM:-}" ] && [ "$(grep -c . "$F/reset-tries")" -ge "$FAKE_RESET_FAIL_FROM" ]; then
			echo "tee: reset: Connection timed out" >&2; exit 1
		fi
		echo "gma500 0000:00:02.0: [drm] SGX reset: BIF_FAULT 0x0 BIF_INT_STAT 0x80000 EVENT_STATUS 0x20000000/0x400" >> "$KMSG"
		echo "gma500 0000:00:02.0: [drm] SGX reset: after the fault clear BIF_FAULT 0x0 BIF_INT_STAT 0x80000" >> "$KMSG"
		: > "$R/kpoke"
		[ -n "${FAKE_STUCK:-}" ] || echo idle > "$F/state"
		exit 0 ;;
	"$DB/"*) read -r v; echo "${2##*/} $v" >> "$F/writes"; echo "${2##*/} $v" >> "$F/other-writes"; exit 0 ;;
	esac
fi
new=()
for a in "$@"; do new+=("${a//$DB/$R}"); done
exec "${new[@]}"
