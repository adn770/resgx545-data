#!/bin/bash
# fake ssh for tests/run_mock.sh: "the laptop" is the directory $FAKE_HOME.  Options (-o X) are skipped, the host is ignored, the
# command runs in bash with HOME=$FAKE_HOME (the sudo shim and the fake tool find the rest in the environment).  The driver's knob
# read (alias_skip, render_rgn_arrays, render_pb_pages, hold_recovery, render_tail_room) answers from the fake debugfs.
while [ "${1:-}" = "-o" ]; do shift 2; done
shift
cmd=$1
case "$cmd" in
*render_rgn_arrays*hold_recovery*render_tail_room*) [ -n "${FAKE_KNOB_UNREADABLE:-}" ] && exit 1
	for k in alias_skip render_rgn_arrays render_pb_pages; do printf '0x%08x\n' $(( $(cat "${FAKE_DBGREAL:?}/$k") )); done
	cat "$FAKE_DBGREAL/hold_recovery"; printf '0x%08x\n' $(( $(cat "$FAKE_DBGREAL/render_tail_room") )); exit 0 ;;
esac
cd "${FAKE_HOME:?}" && HOME=$FAKE_HOME exec bash -c "$cmd"
