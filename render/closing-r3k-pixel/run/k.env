# SPDX-License-Identifier: MIT
# k.env: the laptop binaries R3K-pixel reuses (the pins of closing3/r3-pixel: ~/sgxfive-test-r1, built from
# userspace/libsgxfive/tools/sgxfive-test.c sha256 4250ca36..., TOOL.sha256 / TOOLSRC.sha256 copied here; ~/regtimeline is S1's)
# and the kernel-batch session K2's expectations.  Sourced by lib_k.sh on the laptop.  The preflight refuses a tool or
# regtimeline with another sha256 and a module that is not the expected build: STOP AND ASK (nothing is rebuilt).
TOOL_SHA=bf4f8be2d8a8fe50034559450928e05695dc96d396d4892f9b00ea6bc0d4f053
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
# the new gma500 module of the kernel batch (fork resgx545 at 8fc748b0, closing3/kernel/series-r3.md): loaded = installed = this
SRCV_EXPECT=230E0EF50FFFD606C53AE3C
# held jobs: the job starts RT_LEAD s after regtimeline; registers read HOLD_READ s after the launch (E444: 2.5 s after the
# tool's start), again HOLD_GAP s later; then hold_recovery N and the reset.  A bif row writes between snap 1 and the reset.
RT_LEAD=${RT_LEAD:-0.3}
HOLD_READ=${HOLD_READ:-2.8}
HOLD_GAP=${HOLD_GAP:-1}
HELD_TIMEOUT=${HELD_TIMEOUT:-60}
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
# the watch of a bif row after its writes (seconds): does the job complete, does the same fault return
BIF_WATCH=${BIF_WATCH:-2.5}
# the laptop must answer within this many seconds after a BIF_CTRL / BIF_INT_STAT write (E317's stall): else stop (rc 18)
BIF_ANSWER=${BIF_ANSWER:-10}
# the session stops at the 5th fault-class event OF A STAGE (a fault or a hang, expected or not), as R2-pixel's limit
FAULT_LIMIT=${K_FAULT_LIMIT:-5}
