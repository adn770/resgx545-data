# SPDX-License-Identifier: MIT
# m.env: the laptop binaries r6-misc uses and the module it expects.  Sourced by lib_m.sh on the laptop and by stage_m.sh.
# t4 = ~/sgxfive-test-rgn4: built from resgx545 r3-rgn4 4623753 (sgxfive-test.c sha256 703cbcea..., TOOLSRC.sha256), unchanged
# since round 4.  t6 = ~/scratch/r6m/bin/sgxfive-test: built by the lead on cachix from resgx545 d9b2969 (lead/build_tool6.sh); its
# sha256 is NOT here: it is the input of run/freeze_m.sh tool6 SHA (TOOL6.sha256) and of every verify.  A tool with another sha256
# or a module that is not the expected build: STOP AND ASK (nothing is rebuilt on the laptop).
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
# the gma500 module of fork a2788bd8 (rgn4: round 3 plus four region-header arrays for 4x contexts): loaded = installed = this
SRCV_EXPECT=99CD90DA26E3AFF9C450517
# the session's laptop prefix (round 6: ~/scratch/<prefix>/{run,stage,out}; work dirs mktemp -d ~/scratch/tmp/r6m.XXXXXX)
PREFIX=r6m
# a job (the largest is q086's 1024 x 768 4x render with every pixel printed, about 9 MB of text)
JOB_TIMEOUT=${JOB_TIMEOUT:-300}
# free space on ~ before each job (KiB): 200 MB (round 6 rule)
MIN_FREE_KB=${MIN_FREE_KB:-204800}
