# SPDX-License-Identifier: MIT
# r7.env: the laptop binaries r7-rp uses and the module it expects.  Sourced by lib_r7.sh on the laptop and by stage_r7.sh.
# t4 = ~/sgxfive-test-rgn4: built from resgx545 r3-rgn4 4623753 (sgxfive-test.c sha256 703cbcea..., TOOLSRC.sha256), unchanged since
# round 4.  t6 = ~/scratch/r7r/bin/sgxfive-test-t6: round 6's build of d9b2969 (TOOL6.sha256, 97df5c0e..., restaged from the Mac copy
# closing6/r6-misc/debug/tool6-i686/sgxfive-test).  t7 = ~/scratch/r7r/bin/sgxfive-test-t7: built by the lead on cachix from resgx545
# main 1c64f3a (lead/build_tool7.sh); its sha256 is the slot TOOL7.sha256 (run/freeze_r7.sh tool7 SHA) and the input of every verify.
# A tool with another sha256 or a module that is not the expected build: STOP AND ASK (nothing is rebuilt on the laptop).
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
TOOL6_SHA=97df5c0ebf5bff2786a59b302e9a8a722bad36f0ef2f5dba11b6f2957f4ad98c
# the gma500 test module of fork 3f0b3e74 (round 6's four-array contexts, render_tail_room, 0x0694 peek, bif_flush): loaded = installed
SRCV_EXPECT=41E2F5C756F96D20F7109A4
# the session's laptop prefix (round 7: ~/scratch/<prefix>/{run,bin,stage,out}; work dirs mktemp -d ~/scratch/tmp/r7r.XXXXXX)
PREFIX=r7r
# a job (the largest: q086's 1024 x 768 4x render and q139's 640 x 480 with every pixel printed, about 9 MB of text)
JOB_TIMEOUT=${JOB_TIMEOUT:-300}
# free space on ~ before each job (KiB): 200 MB (round 7 rule)
MIN_FREE_KB=${MIN_FREE_KB:-204800}
