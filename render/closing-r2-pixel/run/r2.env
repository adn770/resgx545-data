# r2.env: the laptop binaries R2-pixel reuses from R1 (built 2026-11-10 09:37 from userspace/libsgxfive/tools/sgxfive-test.c
# sha256 4250ca36..., unchanged in the main checkout since: stage-r1.log; regtimeline is S1's, built from tools/sweep) and the
# R2 timing.  Sourced by lib_r2.sh on the laptop.  The preflight refuses a tool or regtimeline with another sha256.
TOOL_SHA=bf4f8be2d8a8fe50034559450928e05695dc96d396d4892f9b00ea6bc0d4f053
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
# held jobs: the job starts RT_LEAD s after regtimeline; registers read HOLD_READ s after the launch
# (E444: 2.5 s after the tool's start), again HOLD_GAP s later; then hold_recovery N and the reset
RT_LEAD=${RT_LEAD:-0.3}
HOLD_READ=${HOLD_READ:-2.8}
HOLD_GAP=${HOLD_GAP:-1}
HELD_TIMEOUT=${HELD_TIMEOUT:-60}
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
# the session stops at the 5th fault-class event (a fault or a hang, expected or not), counted across stages
FAULT_LIMIT=${R2_FAULT_LIMIT:-5}
