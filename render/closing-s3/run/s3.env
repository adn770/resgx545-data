# s3.env: the laptop binaries S3 reuses from S1 (out of S1's stage.log, 2026-11-09 22:26; built from
# userspace/libsgxfive/tools/sgxfive-test.c sha256 42540a78..., unchanged since) and the S3 timing.
# Sourced by lib_s3.sh on the laptop.  The preflight refuses a tool or regtimeline with another sha256.
TOOL_SHA=d776afbcb9f26a3fccc8dc6be5fa513f8843a0b2185e78c66d2c4737ade0714e
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
# held jobs: the job starts RT_LEAD s after regtimeline; registers read HOLD_READ s after the launch
# (E444: 2.5 s after the tool's start), again HOLD_GAP s later; then hold_recovery N and the reset
RT_LEAD=${RT_LEAD:-0.3}
HOLD_READ=${HOLD_READ:-2.8}
HOLD_GAP=${HOLD_GAP:-1}
HELD_TIMEOUT=${HELD_TIMEOUT:-60}
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
