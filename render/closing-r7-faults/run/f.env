# SPDX-License-Identifier: MIT
# f.env: what r7-faults expects on the laptop.  Sourced by lib_f.sh on the laptop and by stage_f.sh / freeze_f.sh on the Mac.
# ~/sgxfive-test-rgn4: built from resgx545 r3-rgn4 4623753 (sgxfive-test.c sha256 703cbcea..., TOOLSRC.sha256), the tool of E848's
# and r6-held's cells and of E088's probe command (`probe --temps 32 --pixels FILE`), unchanged; a tool with another sha256 or a
# module that is not the expected build: STOP AND ASK (nothing is rebuilt).
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
# the gma500 module of fork r6-kernel 3f0b3e74 (rgn4 + render_tail_room + peek + bif_flush; kregnow as before), the module r6-held
# ran on (one-shot boot 2026-11-12 15:37): loaded = installed = this
SRCV_EXPECT=41E2F5C756F96D20F7109A4
# a job (640 x 480 at most) and a probe fill
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
# a step of a cell (a 64 x 64 triangle; a replay fault is recovered by the kernel within about 2 s with a -110, E848, r6-held)
STEP_TIMEOUT=${STEP_TIMEOUT:-60}
# the held jobs: registers HOLD_READ s after the launch (snap 1), HOLD_GAP s later (snap 2), [clr: the two kregnow writes],
# [long: LONG_EXTRA s more, so that the reset comes about 9 s after the launch: E826 f2's 9.1 s], then the debugfs reset with the
# hold still Y; the job is bounded by HELD_TIMEOUT
HOLD_READ=${HOLD_READ:-2.8}
HOLD_GAP=${HOLD_GAP:-1}
LONG_EXTRA=${LONG_EXTRA:-5.2}
HELD_TIMEOUT=${HELD_TIMEOUT:-60}
# a kregnow write or a regs read right after one must answer within BIF_ANSWER s (E317's stall: else the session stops untouched)
BIF_ANSWER=${BIF_ANSWER:-10}
# the session's budget of timed-out boots ("SGX boot: no INIT_COMPLETE", decision 3 (a)): reaching it ends the session after the
# cell's health; counted from each row's kernel-log slice into ~/scratch/r7f/run/minus110.ledger (every attempt of the session)
BUDGET_110=${BUDGET_110:-16}
# free space on ~ before each job (MiB; HACKING's floor is 200)
MIN_FREE_MB=${MIN_FREE_MB:-300}
