# SPDX-License-Identifier: MIT
# k.env: the laptop binary r5-render4x uses (unchanged from R4-G) and the module it expects.  Sourced by lib_k.sh on the laptop and by stage_k.sh.
# ~/sgxfive-test-rgn4: built from resgx545 r3-rgn4 4623753 (sgxfive-test.c sha256 703cbcea..., TOOLSRC.sha256); a tool with another
# sha256 or a module that is not the expected build: STOP AND ASK (nothing is rebuilt).
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
# the gma500 module of fork a2788bd8 (round 3 plus four region-header arrays for 4x contexts): loaded = installed = this
SRCV_EXPECT=99CD90DA26E3AFF9C450517
# a job (the largest is m4, a 2048 x 1536 target on a 4096 x 4096 context, checked pixel by pixel on the laptop's CPU)
JOB_TIMEOUT=${JOB_TIMEOUT:-300}
# the held job (stage d): the registers are read HOLD_READ s after the launch (E444, K2: 2.8 s), again HOLD_GAP s later,
# then the kernel's own debugfs reset with the hold still Y; the job is bounded by HELD_TIMEOUT
HOLD_READ=${HOLD_READ:-2.8}
HOLD_GAP=${HOLD_GAP:-1}
HELD_TIMEOUT=${HELD_TIMEOUT:-60}
