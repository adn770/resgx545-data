# session expects.  Sourced by lib_k.sh on the laptop.  The preflight refuses a tool with another sha256 and a module that is
# not the expected build: STOP AND ASK (nothing is rebuilt).  No regtimeline in this session.
TOOL_SHA=bf4f8be2d8a8fe50034559450928e05695dc96d396d4892f9b00ea6bc0d4f053
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
# the new gma500 module of the kernel batch (fork resgx545 at 8fc748b0): loaded = installed = this
SRCV_EXPECT=230E0EF50FFFD606C53AE3C
