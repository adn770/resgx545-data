# r4.env: the laptop binaries R4-pixel uses: ~/sgxfive-test-rgn4 (the tool of round 4's sessions, built from the fork a2788bd8's tree,
# sha256 e6951558..., the pin of closing3/r4-reruns/a-q285/TOOL.sha256) and ~/regtimeline (S1's, built from tools/sweep, read-only)
# and the R4-pixel timing.  Sourced by lib_r4.sh on the laptop.  The preflight refuses a tool or regtimeline with another
# sha256 and a kernel module that is not the expected build: STOP AND ASK (nothing is rebuilt).
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
SRCV_EXPECT=99CD90DA26E3AFF9C450517
# regtimeline: TOTAL (0 = until the command ends) and LEAD seconds before the tool starts
RT_LEAD=${RT_LEAD:-0.3}
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
