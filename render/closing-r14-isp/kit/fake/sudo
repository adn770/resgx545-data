# fake sudo of the kit's mock (session.py mock). The mock debugfs directory $KIT_DEBUGFS is mode
# 000: only through this shim (as on the laptop, where debugfs is root only) does a path in it
# reach the real files in $FAKE_DBGREAL. regs and reset act on the fake GPU state in
# $FAKE_DIR/state ("idle", or "INT WORD": a latched fault). A leading `timeout [-k K] N` is
# stripped. Every debugfs write is logged in $FAKE_DIR/writes ("NAME VALUE"). dmesg reads the
# fake kernel log $KIT_KMSG; journalctl fails (the runner falls back to dmesg). FAKE_RESET_FAIL:
# every reset fails; FAKE_SNAP_FAIL: regs unreadable.
[ "${1:-}" = "-n" ] && shift
DB=${KIT_DEBUGFS:?}; R=${FAKE_DBGREAL:?}; F=${FAKE_DIR:?}
if [ "$1" = timeout ]; then shift; [ "$1" = "-k" ] && shift 2; shift; fi
case "$1" in dmesg) cat "${KIT_KMSG:?}"; exit 0 ;; journalctl) exit 1 ;; esac
regs() {
	local w=0 a=0
	read -r st aa < "$F/state"
	[ "$st" = idle ] || { w=$st; a=$aa; }
	printf 'sgxfive regs 1\nreg 0x0000 0x0000a6aa\nreg 0x0c00 0x00000000\nreg 0x0c04 0x%08x\nreg 0x0c08 0x%08x\n' \
		$(( w | 0x80000 )) $(( a ))
}
if [ "$1" = cat ]; then
	case "$2" in
	"$DB/regs") [ -n "${FAKE_SNAP_FAIL:-}" ] && { echo "cat: regs: Input/output error" >&2; exit 1; }
		regs; exit 0 ;;
	"$DB/"*) cat "$R/${2##*/}"; exit $? ;;
	esac
fi
if [ "$1" = tee ]; then
	case "$2" in
	"$DB/reset")
		cat > /dev/null
		echo "reset 1" >> "$F/writes"
		[ -n "${FAKE_RESET_FAIL:-}" ] && { echo "tee: reset: Connection timed out" >&2; exit 1; }
		echo "gma500 0000:00:02.0: [drm] SGX reset: BIF_FAULT 0x0 BIF_INT_STAT 0x80000" >> "$KIT_KMSG"
		echo idle > "$F/state"
		exit 0 ;;
	"$DB/"*) read -r v; echo "${2##*/} $v" >> "$F/writes"; echo "$v" > "$R/${2##*/}"; exit 0 ;;
	esac
fi
new=()
for a in "$@"; do new+=("${a//$DB/$R}"); done
exec "${new[@]}"
