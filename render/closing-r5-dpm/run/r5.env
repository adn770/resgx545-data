# SPDX-License-Identifier: MIT
# r5.env: the laptop binaries R5-dpm uses, sourced by lib_r5.sh on the laptop.  ~/sgxfive-test-rgn4 (round 4's tool, built from the
# rgn4 tree of fork a2788bd8, sha256 e6951558...: the pin of closing4/r4-pixel and r4-render4x) and ~/regtimeline (S1's, built from
# tools/sweep/regtimeline.c, read-only /dev/mem reads; the pin of R3-pixel and R4-pixel).  The preflight refuses another tool, another
# regtimeline or a module other than the rgn4 build (srcversion 99CD90DA26E3AFF9C450517, handover 2026-11-12): STOP AND ASK, nothing
# is rebuilt.
TOOL_SHA=e6951558a93b4b7bc750eeae302997992d7ec6e26719bc527ba1ffc9c6fb779a
RT_SHA=079f63590ce87ff2a1ac5499291e52340ff448d9c5e41942a9420264764de803
SRCV_EXPECT=99CD90DA26E3AFF9C450517
# the own task of stage A3 (bins/oomring.blob, gen/gen_oomring.py) and its arm string (PDS #13 slots 0 to 3, entries 0..3)
OOMRING_SHA=5b2fcf025a2994d68a7b082020095d79b847f473a8c94cd149c07f6eb60236f7
OOMRING_ARM="slots=0xf entry=0,1,2,3"
# regtimeline: TOTAL 0 (until the command ends) and LEAD seconds before the tool starts
RT_LEAD=${RT_LEAD:-0.3}
JOB_TIMEOUT=${JOB_TIMEOUT:-120}
