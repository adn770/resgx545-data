#!/bin/sh
[ "$1" = "-n" ] && shift
case "$1" in dmesg) cat "${KMSG:-/dev/null}"; exit 0 ;; journalctl) exit 1 ;; esac
# the kernel prints a debugfs x32 as 0x%08x: the shim does the same for the knob; a reset disarms the own task (as the kernel's)
if [ "$1" = cat ]; then
	case "$2" in */render_pb_pages) printf '0x%08x\n' $(( $(cat "$2") )); exit 0 ;; esac
fi
if [ "$1" = tee ] && [ "${2:-}" != -a ]; then case "$2" in */reset) echo "off" > "$(dirname "$2")/own_arm"; echo reset >> "$(dirname "$2")/resets.log" ;; esac; fi
exec "$@"
