  y^0x1000: OR [] ADD [] 
  y^0x2000: OR [0] ADD [0] 
  y^0x3000: OR [0] ADD [0] 
  y^0x4000: OR [0, 1] ADD [0, 1] 
fill 64x128: 2 tile columns, 8 tile rows
  x^0x8: OR [] ADD [] 
  x^0x10: OR [0] ADD [0] 
  x^0x18: OR [0] ADD [0] 
  x^0x20: OR [0, 1] ADD [0, 1] 
  y^0x1000: OR [] ADD [] 
  y^0x2000: OR [0, 2, 4, 6] ADD [0] SEPARATES
  y^0x3000: OR [0, 2, 4, 6] ADD [0] SEPARATES
  y^0x4000: OR [0, 1, 4, 5] ADD [0, 1] SEPARATES
  y^0x5000: OR [0, 1, 4, 5] ADD [0, 1] SEPARATES
  y^0x6000: OR [0, 1, 2, 4, 5, 6] ADD [0, 1, 2] SEPARATES
  y^0x7000: OR [0, 1, 2, 4, 5, 6] ADD [0, 1, 2] SEPARATES
  y^0x8000: OR [0, 1, 2, 3] ADD [0, 1, 2, 3] 
  y^0x9000: OR [0, 1, 2, 3] ADD [0, 1, 2, 3] 
  y^0xa000: OR [0, 1, 2, 3, 4, 6] ADD [0, 1, 2, 3, 4] SEPARATES
  y^0xb000: OR [0, 1, 2, 3, 4, 6] ADD [0, 1, 2, 3, 4] SEPARATES
  y^0xc000: OR [0, 1, 2, 3, 4, 5] ADD [0, 1, 2, 3, 4, 5] 
