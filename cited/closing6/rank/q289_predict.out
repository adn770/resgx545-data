  x^0x20: OR [0, 1, 4, 5] ADD [0, 1] SEPARATES
  x^0x28: OR [0, 1, 4, 5] ADD [0, 1] SEPARATES
  x^0x30: OR [0, 1, 2, 4, 5, 6] ADD [0, 1, 2] SEPARATES
  x^0x38: OR [0, 1, 2, 4, 5, 6] ADD [0, 1, 2] SEPARATES
  x^0x40: OR [0, 1, 2, 3] ADD [0, 1, 2, 3] 
  x^0x48: OR [0, 1, 2, 3] ADD [0, 1, 2, 3] 
  x^0x50: OR [0, 1, 2, 3, 4, 6] ADD [0, 1, 2, 3, 4] SEPARATES
  x^0x58: OR [0, 1, 2, 3, 4, 6] ADD [0, 1, 2, 3, 4] SEPARATES
  x^0x60: OR [0, 1, 2, 3, 4, 5] ADD [0, 1, 2, 3, 4, 5] 
