fill 128x64: 4 tile columns, 4 tile rows
  x^0x8: OR [] ADD [] 
  x^0x10: OR [0, 2] ADD [0] SEPARATES
  x^0x18: OR [0, 2] ADD [0] SEPARATES
  x^0x20: OR [0, 1] ADD [0, 1] 
  x^0x28: OR [0, 1] ADD [0, 1] 
  x^0x30: OR [0, 1, 2] ADD [0, 1, 2] 
  x^0x38: OR [0, 1, 2] ADD [0, 1, 2] 
  x^0x40: OR [0, 1, 2, 3] ADD [0, 1, 2, 3] 
  y^0x1000: OR [] ADD [] 
  y^0x2000: OR [0, 2] ADD [0] SEPARATES
  y^0x3000: OR [0, 2] ADD [0] SEPARATES
  y^0x4000: OR [0, 1] ADD [0, 1] 
  y^0x5000: OR [0, 1] ADD [0, 1] 
  y^0x6000: OR [0, 1, 2] ADD [0, 1, 2] 
  y^0x7000: OR [0, 1, 2] ADD [0, 1, 2] 
  y^0x8000: OR [0, 1, 2, 3] ADD [0, 1, 2, 3] 
